# Backup
# https://github.com/github/gitignore/blob/main/Global/Backup.gitignore
#───────────────────────────────────────────────────────────────────────────────

# Generic backup files
*.bak
*.back
*.backup

# Norton Ghost backup files
*.gho

# Generic original files
*.ori
*.orig
*.original

# Generic temporary files
*.tmp
*.temp
*.temporary

