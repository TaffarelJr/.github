{
  "recommendations": [
    // Mermaid diagram rendering in Markdown preview
    "bierner.markdown-mermaid",
    // EditorConfig support (extends VS Code's native support)
    "editorconfig.editorconfig",
    // GitHub Actions workflow schema validation and IntelliSense
    "github.vscode-github-actions",
    // PlantUML diagram preview (used in docs/)
