    // XML language support (used for .csproj, .props, .config, etc.)
    "redhat.vscode-xml",
    // YAML schema validation and IntelliSense (GitHub Actions, docker-compose)
    "redhat.vscode-yaml",
    // Markdown formatting (table auto-format, list continuation, TOC)
    "yzhang.markdown-all-in-one"
  ]
}
